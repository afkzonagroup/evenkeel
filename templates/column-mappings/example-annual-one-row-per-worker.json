{
  "$schema": "https://github.com/afkzonagroup/evenkeel/blob/main/schema/config-v1.schema.json",
  "description": "EXAMPLE ONLY - verify every column name, code and number format against your own export before use. Replace each 'CHOOSE: ...' value with one option; see docs/configuration.md. This is not the documented format of any particular payroll or HR product.",
  "version": 1,
  "csv": {
    "delimiter": ",",
    "decimalSeparator": ".",
    "thousandsSeparator": "none",
    "encoding": "utf-8"
  },
  "columns": {
    "workerId": "employee_id",
    "gender": "gender",
    "category": "job_category",
    "basicPay": [
      "base_salary"
    ],
    "complementaryPay": [
      "bonus",
      "overtime_pay",
      "allowances",
      "benefits_in_kind"
    ],
    "hours": "paid_hours",
    "fte": "fte"
  },
  "genderCodes": {
    "female": [
      "F"
    ],
    "male": [
      "M"
    ],
    "other": []
  },
  "otherGender": "CHOOSE: reject | exclude | include-in-totals",
  "payBases": [
    "annual",
    "hourly"
  ],
  "annualPay": "CHOOSE: actual | full-time-equivalent",
  "complementaryGapPopulation": "CHOOSE: recipients | all-workers",
  "quartileMethod": "CHOOSE: exact-equal-groups | whole-workers-ties-together",
  "minimumGroupSize": 5,
  "duplicateWorkerRows": "reject",
  "decimals": 2
}
