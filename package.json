{
  "name": "@afkzona/evenkeel",
  "version": "0.1.0",
  "description": "Pay-gap indicators of the EU Pay Transparency Directive (EU) 2023/970, computed locally from a payroll CSV: Article 9 indicators, Article 10 joint pay assessment trigger, Article 5 and 7 helpers, reports.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/evenkeel.git"
  },
  "homepage": "https://github.com/afkzonagroup/evenkeel#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/evenkeel/issues"
  },
  "keywords": [
    "pay-transparency",
    "gender-pay-gap",
    "directive-2023-970",
    "equal-pay",
    "payroll",
    "eu",
    "offline"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "evenkeel": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/report-v1.json": "./schema/report-v1.schema.json",
    "./schema/config-v1.json": "./schema/config-v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "schema/",
    "templates/",
    "LICENSE",
    "LICENSE-ADDITIONAL-TERMS.md",
    "COMMERCIAL.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
