{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afkzonagroup/evenkeel/blob/main/schema/report-v1.schema.json",
  "title": "Evenkeel pay transparency report, schema version 1",
  "description": "Aggregated indicators of Article 9(1) of Directive (EU) 2023/970 and the Article 10(1) test. Contains no worker ids and no individual pay. Amounts and percentages are decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generator", "generatedAt", "legalBasis", "employer", "referencePeriod", "currency", "smallGroupProtection", "choices", "data", "indicators", "jointPayAssessment", "notes", "notLegalAdvice"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "attribution", "url"],
      "properties": {
        "name": { "const": "Evenkeel" },
        "version": { "type": "string" },
        "attribution": { "const": "Evenkeel by AFKzona Group" },
        "url": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string" },
    "legalBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["act", "celex", "url"],
      "properties": { "act": { "type": "string" }, "celex": { "const": "32023L0970" }, "url": { "type": "string" } }
    },
    "employer": { "type": ["string", "null"] },
    "referencePeriod": { "type": ["string", "null"] },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "smallGroupProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimumGroupSize"],
      "properties": { "enabled": { "type": "boolean" }, "minimumGroupSize": { "type": "integer", "minimum": 1 } }
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setting", "value", "explanation", "legalBasis", "legalBasisUrl"],
        "properties": {
          "setting": { "type": "string" },
          "value": { "type": "string" },
          "explanation": { "type": "string" },
          "legalBasis": { "type": "string" },
          "legalBasisUrl": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataRows", "rowsUsed", "rowsOtherPeriod", "workers", "female", "male", "other"],
      "properties": {
        "dataRows": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "rowsUsed": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "rowsOtherPeriod": { "$ref": "#/$defs/count" },
        "workers": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "female": { "$ref": "#/$defs/count" },
        "male": { "$ref": "#/$defs/count" },
        "other": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] }
      }
    },
    "indicators": { "$ref": "#/$defs/indicators" },
    "jointPayAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["computed", "categories", "thresholdMetIn", "remedyPeriodEnds"],
      "properties": {
        "computed": { "type": "boolean" },
        "thresholdMetIn": { "type": "array", "items": { "type": "string" } },
        "remedyPeriodEnds": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "byBasis", "conditionA", "conditionB", "conditionC", "assessmentRequired"],
            "properties": {
              "category": { "type": "string" },
              "byBasis": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["basis", "gap", "threshold"],
                  "properties": { "basis": { "$ref": "#/$defs/basis" }, "gap": { "$ref": "#/$defs/figure" }, "threshold": { "$ref": "#/$defs/threshold" } }
                }
              },
              "conditionA": { "enum": ["met", "not-met", "not-determinable", "withheld"] },
              "conditionB": { "$ref": "#/$defs/condition" },
              "conditionC": { "$ref": "#/$defs/condition" },
              "assessmentRequired": { "enum": ["yes", "no", "unknown"] }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "notLegalAdvice": { "type": "string" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "basis": { "enum": ["annual", "hourly"] },
    "threshold": { "enum": ["met", "not-met", "not-determinable", "withheld"] },
    "condition": { "enum": ["met", "not-met", "unknown"] },
    "figure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": { "status": { "const": "ok" }, "value": { "$ref": "#/$defs/decimal" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": { "status": { "const": "suppressed" }, "reason": { "enum": ["below-minimum-group-size", "few-recipients", "secondary-suppression"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "not-applicable" },
            "reason": { "enum": ["no-female-workers", "no-male-workers", "no-female-recipients", "no-male-recipients", "no-workers", "male-average-is-zero", "male-median-is-zero"] }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["female", "male", "gap"],
      "properties": {
        "female": { "$ref": "#/$defs/averageGroup" },
        "male": { "$ref": "#/$defs/averageGroup" },
        "gap": { "$ref": "#/$defs/figure" }
      }
    },
    "averageGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "average"],
      "properties": { "workers": { "$ref": "#/$defs/count" }, "average": { "$ref": "#/$defs/figure" } }
    },
    "medianGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["female", "male", "gap"],
      "properties": {
        "female": { "$ref": "#/$defs/medianGroup" },
        "male": { "$ref": "#/$defs/medianGroup" },
        "gap": { "$ref": "#/$defs/figure" }
      }
    },
    "medianGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "median"],
      "properties": { "workers": { "$ref": "#/$defs/count" }, "median": { "$ref": "#/$defs/figure" } }
    },
    "categorySex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "basicAverage", "complementaryAverage", "totalAverage"],
      "properties": {
        "workers": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "basicAverage": { "$ref": "#/$defs/figure" },
        "complementaryAverage": { "$ref": "#/$defs/figure" },
        "totalAverage": { "$ref": "#/$defs/figure" }
      }
    },
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workersIncluded", "proportionReceivingComplementary", "bases"],
      "properties": {
        "workersIncluded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["female", "male", "otherInBands"],
          "properties": { "female": { "$ref": "#/$defs/count" }, "male": { "$ref": "#/$defs/count" }, "otherInBands": { "$ref": "#/$defs/count" } }
        },
        "proportionReceivingComplementary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["female", "male"],
          "properties": {
            "female": { "$ref": "#/$defs/receiving" },
            "male": { "$ref": "#/$defs/receiving" }
          }
        },
        "bases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "genderPayGap", "complementaryPayGap", "medianGenderPayGap", "medianComplementaryPayGap", "quartilePayBands", "categories"],
            "properties": {
              "basis": { "$ref": "#/$defs/basis" },
              "genderPayGap": { "$ref": "#/$defs/gap" },
              "complementaryPayGap": { "$ref": "#/$defs/gap" },
              "medianGenderPayGap": { "$ref": "#/$defs/medianGap" },
              "medianComplementaryPayGap": { "$ref": "#/$defs/medianGap" },
              "quartilePayBands": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["band", "workers", "female", "male"],
                  "properties": {
                    "band": { "enum": [1, 2, 3, 4] },
                    "workers": { "$ref": "#/$defs/decimal" },
                    "female": { "$ref": "#/$defs/figure" },
                    "male": { "$ref": "#/$defs/figure" }
                  }
                }
              },
              "categories": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["category", "female", "male", "basicPayGap", "complementaryPayGap", "totalPayGap", "jointAssessmentThreshold"],
                      "properties": {
                        "category": { "type": "string" },
                        "female": { "$ref": "#/$defs/categorySex" },
                        "male": { "$ref": "#/$defs/categorySex" },
                        "basicPayGap": { "$ref": "#/$defs/figure" },
                        "complementaryPayGap": { "$ref": "#/$defs/figure" },
                        "totalPayGap": { "$ref": "#/$defs/figure" },
                        "jointAssessmentThreshold": { "$ref": "#/$defs/threshold" }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "receiving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "proportion"],
      "properties": { "workers": { "$ref": "#/$defs/count" }, "proportion": { "$ref": "#/$defs/figure" } }
    }
  }
}
